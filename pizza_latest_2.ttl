#    Object Properties
#################################################################

###  http://example.org/kr-project/pizza#containsAllergen
:containsAllergen rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Ingredient ;
                  rdfs:range :Allergen .


###  http://example.org/kr-project/pizza#cookedBy
:cookedBy rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain :Pizza ;
          rdfs:range :CookingMethod .


###  http://example.org/kr-project/pizza#hasBase
:hasBase rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :hasIngredient ;
         rdf:type owl:FunctionalProperty ;
         rdfs:domain :Pizza ;
         rdfs:range :PizzaBase .


###  http://example.org/kr-project/pizza#hasCheese
:hasCheese rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :hasTopping ;
           rdfs:domain :Pizza ;
           rdfs:range :CheeseTopping .


###  http://example.org/kr-project/pizza#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               owl:inverseOf :isIngredientOf ;
               rdf:type owl:TransitiveProperty ;
               rdfs:range :Ingredient .


###  http://example.org/kr-project/pizza#hasSauce
:hasSauce rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :hasIngredient ;
          rdfs:domain :Pizza ;
          rdfs:range :Sauce .


###  http://example.org/kr-project/pizza#hasSpiciness
:hasSpiciness rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Ingredient ;
              rdfs:range :Spiciness .


###  http://example.org/kr-project/pizza#hasStyle
:hasStyle rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain :Pizza ;
          rdfs:range :PizzaStyle .


###  http://example.org/kr-project/pizza#hasTopping
:hasTopping rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasIngredient ;
            rdfs:domain :Pizza ;
            rdfs:range :Topping .


###  http://example.org/kr-project/pizza#isIngredientOf
:isIngredientOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty .


###  http://example.org/kr-project/pizza#isVariantOf
:isVariantOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty .


