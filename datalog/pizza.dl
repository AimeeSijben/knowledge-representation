//1.3 properties of ingredients
.decl spicinessLevel(level:symbol)
spicinessLevel("Mild").
spicinessLevel("Medium").
spicinessLevel("Hot").

.decl hasSpiciness(ingredient:symbol, level:symbol)
hasSpiciness("ChiliPepper", "Hot").
hasSpiciness("Pepperoni", "Medium").
hasSpiciness("Salami", "Medium").

.decl containsAllergen(ingredient:symbol, allergen:symbol)
containsAllergen("Mozzarella", "Dairy").
containsAllergen("Gorgonzola", "Dairy").
containsAllergen("Parmesan", "Dairy").
containsAllergen("Ricotta", "Dairy").
containsAllergen("Pesto", "Dairy").
containsAllergen("Dough", "Gluten").
containsAllergen("NutTopping", "Nuts").
containsAllergen("SeafoodTopping", "Fish").


//2. RULES

//2.1 recursive subclass relationships
.decl subClassOf(child:symbol, parent:symbol)

subClassOf(x,y) :- subClass(x,y).
//AxAy(subClass(x,y) --> subClassOf(x,y)) So :- == <-- 

subClassOf(x,z) :-
    subClass(x,y),
    subClassOf(y,z).
//AxAyAz((subClass(x,y) AND subClassOf(y,z)) --> subClassOf(x,z)) So ':-; == 'if' ',' == 'AND;

.output subClassOf

//2.2 ingredient classifications
.decl hasIngredient(pizza:symbol, ingredient:symbol)
hasIngredient(p, i) :- hasTopping(p, i).
hasIngredient(p, i) :- hasSauce(p, i).

.decl containsCategory(pizza:symbol, category:symbol)
containsCategory(p, c) :-
    hasIngredient(p, i),
    subClassOf(i, c).
.output containsCategory
//if pizza p has ingredient i, and ingredient i is a subclass of category c, then pizza p contains an ingredient of category c

.decl containsMeat(pizza:symbol)
containsMeat(p) :-
    containsCategory(p, "MeatTopping").
.output containsMeat

.decl containsCheese(pizza:symbol)
containsCheese(p) :-
    containsCategory(p, "CheeseTopping").
.output containsCheese

.decl containsVegetable(pizza:symbol)
containsVegetable(p) :-
    containsCategory(p, "VegetableTopping").
.output containsVegetable

.decl containsSeafood(pizza:symbol)
containsSeafood(p) :-
    containsCategory(p, "SeafoodTopping").
 .output containsSeafood

//infer allergens from ingredients

.decl ingredientAllergen(ingredient:symbol, allergen:symbol)    //create a relation called ingredientAllergen that takes two arguments
ingredientAllergen(i, a) :-                                     //then ingredient i has allergen a
    containsAllergen(a)                                         //if ingredient i contains allergen a,

ingredientAllergen(i, a) :-                                     //then ingredient i contains allergen a 
    subClassOf(i, c),                                           //if ingredient i is a subclass of category c
    containsAllergen(c, a).                                     //and category c contains allergen a
 
.decl pizzaAllergen(pizza:symbol, allergen:symbol)              //create a relation called pizzaAllergen that takes two arguments 
pizzaAllergen(p, a) :-                                          //then p contains allergen a
    pizza(p),                                                   //if p is a pizza 
    hasIngredient(p, i),                                        //and p has ingredient a
    ingredientAllergen(i, a).                                   //and ingredient i has allergen a
.output pizzaAllergen

//infer which pizzas contain dairy
.decl containsDairy(pizza:symbol)                               //create relation containsDairy taking one argument
containsDairy(p) :-                                             //then pizza contains dairy
    pizzaAllergen(p, "Dairy").                                  //if p contains allergen "Dairy"
.output containsDairy

//2.3 spicy pizzas

.decl ingredientSpiciness(ingredient:symbol, level:symbol)
ingredientSpiciness(i, s) :-
    hasSpiciness(i, s).

ingredientSpiciness(i, s) :-
    subClassOf(i, c),
    hasSpiciness(c, s).

.decl pizzaSpiciness(pizza:symbol, level:symbol)
pizzaSpiciness(p, s) :-
    hasIngredient(p, i)
    ingredientSpiciness(i, s)
.output pizzaSpiciness

.decl spicy(pizza:symbol)
spicy(p) :-
    pizzaSpiciness(p, s),
    spicinessLevel(s).
.output spicy

//2.4 meat and vegetable pizzas
.decl meatAndVegetable(pizza:symbol)
meatAndVegetable(p) :-
    containsMeat(p),
    containsVegetable(p).
.output meatAndVegetable

//2.5 vegetarian pizzas
.decl pizza(p:symbol)
pizza(p) :-
    subClassOf(p, "NamedPizza").

.decl vegetarian(pizza:symbol)
vegetarian(p) :-
    pizza(p),
    !containsMeat(p),
    !containsSeafood(p).
.output vegetarian

//2.6 vegan pizzas
.decl vegan(pizza:symbol) 
vegan(p) :-
    vegetarian(p),
    !containsMeat(p),
    !containsAllergen(p).
.output vegan

//2.7 dairyFree pizzas
.decl dairyFree(pizza:symbol)
dairyFree(p) :-
    pizza(p),
    !containsDairy(p).
.output dairyFree

//2.8 