//1.2 ingredients of each pizza
.decl hasTopping(pizza:symbol, topping:symbol)
.decl hasSauce(pizza:symbol, sauce:symbol)
.decl hasBase(pizza:symbol, base:symbol)
.decl baseContains(base:symbol, ingredient:symbol)

baseContains("StandardBase", "Dough").
hasBase(p, "StandardBase") :-                       //then p has base standardbase
    pizza(p).                                       // if p is a pizza

hasIngredient(p, i) :-                              //then p has ingredient i
    hasBase(p, b),                                  //if p has base b
    baseContains(b, i).                             //ans base b contains ingredient i

//Margherita
hasSauce("Margherita", "TomatoSauce").
hasTopping("Margherita", "Mozzarella").
hasTopping("Margherita", "Basil").

//Marinara
hasSauce("Marinara", "TomatoSauce").
